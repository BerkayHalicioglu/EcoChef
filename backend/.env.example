# ─────────────────────────────────────────────────────────────────────────────
# EcoChef Backend — Ortam Değişkenleri Şablonu
# Bu dosyayı kopyalayıp ".env" olarak kaydedin ve değerleri doldurun.
# ─────────────────────────────────────────────────────────────────────────────

# Spoonacular API anahtarı — https://spoonacular.com/food-api adresinden alın
SPOONACULAR_API_KEY=your_spoonacular_api_key_here

# JWT gizli anahtarı — en az 32 karakter, rastgele üretilmiş olmalı
# Üretmek için: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=buraya-en-az-32-karakter-rastgele-deger-girin

# MySQL bağlantı bilgileri
# Docker Compose kullanıyorsanız MYSQL_HOST=mysql olarak bırakın
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=ecochef
MYSQL_PASSWORD=ecochef_pass
MYSQL_DB=ecochef
